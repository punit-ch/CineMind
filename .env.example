# CineMind Environment Variables
# Copy this to .env and fill in your values

# ─── Node ──────────────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=3000

# ─── TMDB (The Movie Database) ─────────────────────────────────────────────────
# Get your API key at https://www.themoviedb.org/settings/api
TMDB_API_KEY=your_tmdb_api_key_here
TMDB_BASE_URL=https://api.themoviedb.org/3
TMDB_IMAGE_BASE_URL=https://image.tmdb.org/t/p

# ─── Google Gemini AI ──────────────────────────────────────────────────────────
# Get your API key at https://aistudio.google.com/apikey
# Free tier: ~15 requests/minute
GEMINI_API_KEY=your_gemini_api_key_here

# Model fallback chain (in order of preference)
# Primary: gemini-1.5-pro-latest
# Fallback 1: gemini-1.5-flash-latest
# Fallback 2: gemini-1.0-pro
GEMINI_MODEL_PRIMARY=gemini-1.5-pro-latest
GEMINI_MODEL_FALLBACK_1=gemini-1.5-flash-latest
GEMINI_MODEL_FALLBACK_2=gemini-1.0-pro

# AI rate limit (requests per minute) - keep under free tier limit
AI_RATE_LIMIT=12

# ─── Supabase ──────────────────────────────────────────────────────────────────
# Create a project at https://supabase.com/dashboard
# Get these from Settings > API
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_ANON_KEY=your_anon_key_here
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key_here

# ─── Auth / Session ────────────────────────────────────────────────────────────
# Optional: session secret for JWT signing (auto-generated if not set)
SESSION_SECRET=your_session_secret_here

# ─── Deployment ────────────────────────────────────────────────────────────────
# Vercel Hobby: automatic
# For production, set your allowed origin
ALLOWED_ORIGIN=https://your-domain.vercel.app