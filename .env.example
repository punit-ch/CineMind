# Copy to .env and fill in
GEMINI_API_KEY=enter enter key here
TMDB_API_KEY=enter key here
PORT=3000
NODE_ENV=development
# Production only: the origin allowed to call the API (e.g. https://cinemind.example.com)
# ALLOWED_ORIGIN=
# Optional overrides
# Model names change often: confirm current free-tier names in Google AI Studio.
# GEMINI_MODEL=gemini-3.5-flash-lite
# Comma-separated models tried in order if the primary one is retired or renamed
# GEMINI_FALLBACK_MODELS=gemini-3.1-flash-lite,gemini-3.8-flash,gemini-2.5-flash
